# Semantic Cache Proxy Configuration

# Port to listen on (default: 8080)
PROXY_PORT=8080

# Upstream LLM Base URL (default: https://api.openai.com)
UPSTREAM_URL=https://api.openai.com

# Optional Upstream API key (Bearer token).
# If unset, client's Authorization header will be forwarded instead.
UPSTREAM_API_KEY=sk-your-openai-api-key-here

# Cosine similarity threshold between 0.0 and 1.0 (default: 0.90)
SIMILARITY_THRESHOLD=0.90

# Maximum number of items in in-memory semantic cache before LRU eviction (default: 10000)
MAX_CACHE_SIZE=10000

# Concurrency limit for generating embeddings (default: 2)
EMBEDDING_CONCURRENCY=2

# Optional path for local model artifacts / cache (default: FastEmbed cache directory)
# MODEL_PATH=./models

# Logging level filter (trace, debug, info, warn, error)
RUST_LOG=info
